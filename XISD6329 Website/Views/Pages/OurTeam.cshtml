@{
    ViewData["Title"] = "Study Better - Our Team";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/site.css" />

    <style>
        .container, .container-fluid {
            max-width: 100% !important;
            margin: 0 !important;
            padding: 0 !important;
        }

        section, div {
            text-align: left;
        }

        body {
            margin: 0;
            font-family: Inter, sans-serif;
            background: #02091C;
            color: white;
        }

        /* Header */
        .header {
            background: #01B697;
            width: 100%;
            height: 47px;
            display: flex;
            align-items: center;
            padding: 0 20px;
            position: relative;
            z-index: 10000;
        }

        .translation {
            font-size: 24px;
            color: black;
        }

        .menu {
            margin-left: auto;
            font-size: 24px;
            color: white;
        }

        .dropdown {
            margin-left: 40px;
            font-size: 20px;
            color: white;
            cursor: pointer;
            text-decoration: underline;
            z-index: 10000;
        }

            .dropdown:hover {
                color: #02091C;
            }

        /* Logo + tagline row */
        .logo-row {
            display: flex;
            width: 100%;
            height: 247px;
        }

        .logo {
            width: 28%;
            background: #D9D9D9;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 40px;
            color: black;
        }

        .tagline {
            width: 72%;
            background: #6D6D6D;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 40px;
            color: white;
        }

        /* Hero section */
        .hero {
            padding: 40px 20px;
            text-align: center;
        }

            .hero h1 {
                font-family: "ADLaM Display", cursive;
                font-size: 64px;
                margin-bottom: 20px;
            }

            .hero p {
                font-size: 16px;
                max-width: 85%;
                margin: 0 auto;
            }

        /* Team section */
        .team {
            display: flex;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 20px;
            padding: 40px 20px;
        }

        .member {
            flex: 1 1 30%;
            background: #D9D9D9;
            color: black;
            padding: 20px;
            box-shadow: 0 10px 4px rgba(0,0,0,0.25);
            text-align: center;
        }

            .member img {
                width: 100%;
                height: auto;
                margin-bottom: 20px;
                background: #6D6D6D;
            }

            .member h2 {
                font-size: 28px;
                margin-bottom: 10px;
            }

            .member p {
                font-size: 16px;
            }

        /* Footer */
        footer {
            background: #01B697;
            width: 100%;
            height: 70px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 36px;
            color: white;
        }
    </style>
</head>
<body>

    <!-- Header -->
    <div class="header">
        <div class="translation">Translation button</div>
        <div class="menu">Select few | menu Items | will go here</div>
        <div class="dropdown">Dropdown for rest</div>
    </div>

    <!-- Logo + tagline row -->
    <div class="logo-row">
        <div class="logo">Logo with just the big letters</div>
        <div class="tagline">The tagline underneath the logo but really big to fill the space in a good way</div>
    </div>

    <!-- Hero -->
    <section class="hero">
        <h1>Our Team</h1>
        <p>
            Can keep the 3 column structure, however would like to have the abouts not have to be expanded, just fully laid out already.
            Could lay it out horizontally as well, possibly ask if there are updated images.
        </p>
    </section>

    <!-- Team section -->
    <section class="team">
        <div class="member">
            <img src="https://placehold.co/300x200" alt="Team member photo">
            <h2>Member Name</h2>
            <p>Short bio or description of the team member.</p>
        </div>
        <div class="member">
            <img src="https://placehold.co/300x200" alt="Team member photo">
            <h2>Member Name</h2>
            <p>Short bio or description of the team member.</p>
        </div>
        <div class="member">
            <img src="https://placehold.co/300x200" alt="Team member photo">
            <h2>Member Name</h2>
            <p>Short bio or description of the team member.</p>
        </div>
    </section>

    <!-- Footer -->
    <footer>
        Footer with relevant info
    </footer>

</body>
</html>
