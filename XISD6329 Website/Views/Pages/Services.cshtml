@{
    ViewData["Title"] = "Study Better - Services";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/site.css" />

    <style>
       /* Add styles specific to the Services page */
        .services 
        {
            padding: 40px 20px;
            max-width: 1000px;
            margin: 0 auto;
        }

            .services h2 
            {
                font-size: 28px;
                margin-bottom: 20px;
                text-align: center;
            }

        .service-item 
        {
            margin-bottom: 20px;
            background: #D9D9D9; /* default background, change using in line styles*/
            color: black;
            padding: 20px;
            box-shadow: 0 10px 4px rgba(0,0,0,0.25);
        }

            .service-item h3 
            {
                font-size: 24px;
                margin-bottom: 10px;
            }

            .service-item p 
            {
                font-size: 18px;
            }

    </style>
</head>
<body>  

    <!-- Holds the title and introductory paragraph about the Services page -->
    <section class="PageIntro">
        <h1>Services</h1>

        <!-- TODO figure out how to style this-->
        <p>
            Current site is just a numbered list.
            Maybe have headings for the things they do and then expand on those services properly.
        </p>
    </section>
    <!-- PageIntro -->

    <!-- Services section -->
    <section class="services">

        <!-- TODO find out what they offer -->
        <h2>What We Offer</h2>

        <div class="service-item">
            <h3>Service One</h3>
            <p>Description of service one goes here.</p>
        </div>

        <div class="service-item">
            <h3>Service Two</h3>
            <p>Description of service two goes here.</p>
        </div>

        <div class="service-item">
            <h3>Service Three</h3>
            <p>Description of service three goes here.</p>
        </div>

    </section>


    <!-- Footer -->
    <footer>
        Footer with relevant info
    </footer>

</body>
</html>
