@{
    ViewData["Title"] = "Study Better - Accommodation";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <style>
        .container, .container-fluid {
            max-width: 100% !important;
            margin: 0 !important;
            padding: 0 !important;
        }

        section, div {
            text-align: left;
        }

        body {
            margin: 0;
            font-family: Inter, sans-serif;
            background: #02091C;
            color: white;
        }

        .header {
            background: #01B697;
            width: 100%;
            height: 47px;
            display: flex;
            align-items: center;
            padding: 0 20px;
            z-index: 10000;
            position: relative;
        }

        .translation {
            font-size: 24px;
            color: black;
        }

        .menu {
            margin-left: auto;
            font-size: 24px;
            color: white;
        }

        .dropdown {
            margin-left: 40px;
            font-size: 20px;
            color: white;
            z-index: 10000;
        }

            .dropdown:hover {
                color: #02091C;
            }

        /* Logo + tagline row */
        .logo-row {
            display: flex;
            width: 100%;
            height: 247px;
        }

        .logo {
            width: 28%;
            background: #D9D9D9;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 40px;
            color: black;
        }

        .tagline {
            width: 72%;
            background: #6D6D6D;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 40px;
            color: white;
        }

        /* Hero section */
        .hero {
            padding: 40px 20px;
        }

            .hero h1 {
                font-family: "ADLaM Display", cursive;
                font-size: 64px;
                margin-bottom: 20px;
                text-align: center;
            }

            .hero p {
                font-size: 16px;
                max-width: 85%;
                margin: 0 auto;
                text-align: center;
            }

        /* Footer */
        footer {
            background: #01B697;
            width: 100%;
            height: 70px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 36px;
            color: white;
        }
    </style>
</head>
<body>

    <!-- Header -->
    <div class="header">
        <div class="translation">Translation button</div>
        <div class="menu">Select few | menu Items | will go here</div>
        <div class="dropdown">Dropdown for rest</div>
    </div>

    <!-- Logo + tagline row -->
    <div class="logo-row">
        <div class="logo">Logo with just the big letters</div>
        <div class="tagline">The tagline underneath the logo but really big to fill the space in a good way</div>
    </div>

    <!-- Hero -->
    <section class="hero">
        <h1>Accommodation</h1>
        <p>
            Unsure what to do here to display the options, there are many photos so some kind of gallery split into the different types of places?
            Will use the logo colours and hold the galleries and descriptions of places in coloured blocks like homepage.
            Discuss with client about what is important.
        </p>
    </section>

    <!-- Footer -->
    <footer>
        Footer with relevant info
    </footer>

</body>
</html>
