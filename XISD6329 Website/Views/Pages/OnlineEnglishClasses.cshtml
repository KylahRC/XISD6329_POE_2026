@{
    ViewData["Title"] = "Study Better - Online English Classes";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/site.css" />

    <style>
        /* Add styles specific to the Online English Classes page */

        .classes 
        {
            display: flex;
            justify-content: space-between; /* even distribution of space */
            flex-wrap: wrap;
            gap: 20px; /* set space between boxes */
            padding: 40px 20px;
        }

        .class-option 
        {
            flex: 1 1 45%; /* holdover relative sizing from Figma 1440x1220 design resolution */
            background: #D9D9D9; /* default background colour, change in the in line per block */
            color: black;
            padding: 20px;
            box-shadow: 0 10px 4px rgba(0,0,0,0.25);
            text-align: center;
        }

            .class-option h2 
            {
                font-size: 32px;
                margin-bottom: 10px;
            }

            .class-option p 
            {
                font-size: 20px;
                margin-bottom: 20px;
            }    
    </style>
</head>
<body>    

    <!-- Holds the title and paragraph about the page -->
    <section class="PageIntro">
        <h1>Online English Classes</h1>

        <!-- TODO get from client-->
        <p>
            Page shows 2 options with pricing.
            Possibly keep the 2 columns and ask for expansion on the service to fill it out more.
        </p>
    </section>
    <!-- Page Intro -->

    <!-- Classes section -->
    <!-- TODO decide on format -->
    <!-- TODO get information on class options -->
    <!--? link directly to orgs or have inquiries routed through SBA for commission -->
    <section class="classes">
        <!-- TODO get image of institute and add img to cards -->
        <div class="class-option">
            <h2>Option 1</h2>
            <p>Details and pricing for option 1.</p>
        </div>
        <div class="class-option">
            <h2>Option 2</h2>
            <p>Details and pricing for option 2.</p>
        </div>
    </section>
    <!-- Classes section -->

    <!-- Footer -->
    <footer>
        Footer with relevant info
    </footer>
    <!-- Footer -->

</body>
</html>
