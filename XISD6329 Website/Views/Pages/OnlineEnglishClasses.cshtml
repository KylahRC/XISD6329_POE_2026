@{
    ViewData["Title"] = "Study Better - Online English Classes";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/site.css" />

    <style>
        .container, .container-fluid {
            max-width: 100% !important;
            margin: 0 !important;
            padding: 0 !important;
        }

        section, div {
            text-align: left;
        }

        body {
            margin: 0;
            font-family: Inter, sans-serif;
            background: #02091C;
            color: white;
        }

        

        /* Hero section */
        .hero {
            padding: 40px 20px;
            text-align: center;
        }

            .hero h1 {
                font-family: "ADLaM Display", cursive;
                font-size: 64px;
                margin-bottom: 20px;
            }

            .hero p {
                font-size: 16px;
                max-width: 85%;
                margin: 0 auto;
            }

        /* Classes section */
        .classes {
            display: flex;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 20px;
            padding: 40px 20px;
        }

        .class-option {
            flex: 1 1 45%;
            background: #D9D9D9;
            color: black;
            padding: 20px;
            box-shadow: 0 10px 4px rgba(0,0,0,0.25);
            text-align: center;
        }

            .class-option h2 {
                font-size: 32px;
                margin-bottom: 10px;
            }

            .class-option p {
                font-size: 20px;
                margin-bottom: 20px;
            }

        /* Footer */
        footer {
            background: #01B697;
            width: 100%;
            height: 70px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 36px;
            color: white;
        }
    </style>
</head>
<body>

    

    <!-- Hero -->
    <section class="hero">
        <h1>Online English Classes</h1>
        <p>
            Page shows the 2 options with pricing.
            Possibly keep the 2 columns and ask for expansion on the service to fill it out more.
        </p>
    </section>

    <!-- Classes section -->
    <section class="classes">
        <div class="class-option">
            <h2>Option 1</h2>
            <p>Details and pricing for option 1.</p>
        </div>
        <div class="class-option">
            <h2>Option 2</h2>
            <p>Details and pricing for option 2.</p>
        </div>
    </section>

    <!-- Footer -->
    <footer>
        Footer with relevant info
    </footer>

</body>
</html>
