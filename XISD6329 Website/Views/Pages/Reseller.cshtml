@{
    ViewData["Title"] = "Study Better - Reseller";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/site.css" />

    <style>
        .container, .container-fluid {
            max-width: 100% !important;
            margin: 0 !important;
            padding: 0 !important;
        }

        section, div {
            text-align: left;
        }

        body {
            margin: 0;
            font-family: Inter, sans-serif;
            background: #02091C;
            color: white;
        }

       
        /* Hero section */
        .hero {
            padding: 40px 20px;
            text-align: center;
        }

            .hero h1 {
                font-family: "ADLaM Display", cursive;
                font-size: 64px;
                margin-bottom: 20px;
            }

            .hero p {
                font-size: 16px;
                max-width: 85%;
                margin: 0 auto;
            }

        /* List section */
        .reseller-list {
            padding: 40px 20px;
            max-width: 1000px;
            margin: 0 auto;
        }

            .reseller-list h2 {
                font-size: 28px;
                margin-bottom: 20px;
                text-align: center;
            }

            .reseller-list ul {
                list-style: disc;
                padding-left: 40px;
                font-size: 18px;
            }

            .reseller-list li {
                margin-bottom: 10px;
            }

        /* Footer */
        footer {
            background: #01B697;
            width: 100%;
            height: 70px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 36px;
            color: white;
        }
    </style>
</head>
<body>

  

    <!-- Hero -->
    <section class="hero">
        <h1>Reseller</h1>
        <p>
            Current text appears AI generated, may raise suspicions of younger generations.
            Unsure what reseller means in this context? Will need a confirmation about what they do.
            Target demo is probably the people in the non‑English places since it would be hard to refer English classes to people who already speak it.
            Another list of things page, will need a way to show the list and description in a fun way.
        </p>
    </section>

    <!-- Reseller list section -->
    <section class="reseller-list">
        <h2>Reseller Opportunities</h2>
        <ul>
            <li>Placeholder item one</li>
            <li>Placeholder item two</li>
            <li>Placeholder item three</li>
        </ul>
    </section>

    <!-- Footer -->
    <footer>
        Footer with relevant info
    </footer>

</body>
</html>
