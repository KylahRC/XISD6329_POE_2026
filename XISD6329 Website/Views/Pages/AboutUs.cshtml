@{
    ViewData["Title"] = "Study Better - About Us";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <style>

        .container, .container-fluid {
            max-width: 100% !important;
            margin: 0 !important;
            padding: 0 !important;
        }

        /* Make all sections flush left */
        section, div {
            text-align: left;
        }


        body {
            margin: 0;
            font-family: Inter, sans-serif;
            background: #02091C;
            color: white;
        }


        /* Hero section */
        .hero {
            padding: 40px 20px;
            text-align: center;
        }

            .hero h1 {
                font-family: "ADLaM Display", cursive;
                font-size: 64px;
                margin-bottom: 20px;
            }

            .hero p {
                font-size: 16px;
                max-width: 100%;
            }

        /* Footer */
        footer {
            background: #01B697;
            width: 100%;
            height: 70px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 36px;
            color: white;
        }
    </style>
</head>
<body>

    

    <!-- Hero -->
    <section class="hero">
        <h1>About Us</h1>
        <p>
            Need a page that explains what their agency really does. Expand on the things not covered in the other pages and summarize the stuff that was. Then add links to the relevant pages to expand on it. Possibly make the about page the first one in the menu list. Must ask client to do write ups for website, we do not know the company like they do.
        </p>
    </section>

    <!-- Footer -->
    <footer>
        Footer with relevant info
    </footer>

</body>
</html>
