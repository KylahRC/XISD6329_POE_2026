@{
    ViewData["Title"] = "Study Better - Language School";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/site.css" />

    <style>
        .container, .container-fluid {
            max-width: 100% !important;
            margin: 0 !important;
            padding: 0 !important;
        }

        section, div {
            text-align: left;
        }

        body {
            margin: 0;
            font-family: Inter, sans-serif;
            background: #02091C;
            color: white;
        }

        

        /* Hero section */
        .hero {
            padding: 40px 20px;
            text-align: center;
        }

            .hero h1 {
                font-family: "ADLaM Display", cursive;
                font-size: 64px;
                margin-bottom: 20px;
            }

            .hero p {
                font-size: 20px;
                max-width: 85%;
                margin: 0 auto;
            }

        /* Schools grid */
        .schools {
            display: flex;
            flex-direction: column;
            gap: 40px;
            padding: 40px 20px;
        }

        .school {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: #2B74DD; /* default background, can vary per block */
            padding: 20px;
            color: white;
        }

            .school.alt1 {
                background: #E3AF20;
            }

            .school.alt2 {
                background: #E86666;
            }

            .school.alt3 {
                background: #01B697;
            }

        .school-logo {
            width: 30%;
            background: #D9D9D9;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 32px;
            color: black;
            height: 200px;
        }

        .school-desc {
            width: 65%;
            font-size: 20px;
            padding: 0 20px;
        }

        /* Footer */
        footer {
            background: #01B697;
            width: 100%;
            height: 70px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 36px;
            color: white;
        }
    </style>
</head>
<body>

    

    <!-- Hero -->
    <section class="hero">
        <h1>Language Schools</h1>
        <p>
            Show the different language schools available.
            Use the column system similar to the home page to carry the design through the site and make it feel cohesive.
        </p>
    </section>

    <!-- Schools grid -->
    <section class="schools">
        <div class="school">
            <div class="school-logo">Logo of school</div>
            <div class="school-desc">Description of school</div>
        </div>
        <div class="school alt1">
            <div class="school-logo">Logo of school</div>
            <div class="school-desc">Description of school</div>
        </div>
        <div class="school alt2">
            <div class="school-logo">Logo of school</div>
            <div class="school-desc">Description of school</div>
        </div>
        <div class="school alt3">
            <div class="school-logo">Logo of school</div>
            <div class="school-desc">Description of school</div>
        </div>
    </section>

    <!-- Footer -->
    <footer>
        Footer with relevant info
    </footer>

</body>
</html>
