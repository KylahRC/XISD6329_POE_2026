@{
    ViewData["Title"] = "Study Better - Language School";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/site.css" />

    <style>
        /* Add styles specific to the Language School page */
        /* Schools grid */
        .SchoolBlocks 
        {
            display: flex;
            flex-direction: column; /* stack vert when small (they already do tho?)*/
            gap: 40px; /* set space beteen box*/
            padding: 40px 20px;
        }

        .SchoolBlock 
        {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: #D9D9D9; /* default background, set colour per block using in line */
            padding: 20px;
            color: white;
        }

        .school-logo 
        {
            width: 30%; /* holdover relative sizing from Figma 1440x1220 design resolution*/
            background: #D9D9D9; /* background when no image*/
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 32px;
            color: black;
            height: 200px;
        }

        .school-desc 
        {
            width: 65%;
            font-size: 20px;
            padding: 0 20px;
        }
    </style>
</head>
