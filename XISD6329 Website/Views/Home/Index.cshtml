@{
    ViewData["Title"] = "Study Better Agency - Home";
}

<div class="text-center my-5">
    <h1 class="display-4 fw-bold">Learn English. Create Opportunities. Change Your Life.</h1>
    <p class="lead text-muted mt-3">Welcome to Study Better Agency. Choose your path below to explore our tailored programs in Cape Town.</p>
</div>

<!-- Market Sector Cards Container -->
<div class="row text-white mt-5">
    
    <!-- Private Demographic Card (Blue) -->
    <div class="col-md-4 mb-4">
        <div class="card h-100 bg-primary border-0 shadow">
            <div class="card-body text-center d-flex flex-column justify-content-between p-4">
                <div>
                    <h3 class="card-title fw-bold">Learn English For Yourself</h3>
                    <p class="card-text mt-3">Improve your daily communication, meet international friends, and experience vibrant student life in Cape Town with homestay options.</p>
                </div>
                <a asp-controller="Pages" asp-action="Accomodation" class="btn btn-light text-primary fw-bold mt-4">Explore Private Options</a>
            </div>
        </div>
    </div>

    <!-- Corporate Sector Card (Gold/Yellow) -->
    <div class="col-md-4 mb-4">
        <div class="card h-100 bg-warning text-dark border-0 shadow">
            <div class="card-body text-center d-flex flex-column justify-content-between p-4">
                <div>
                    <h3 class="card-title fw-bold">Improve Employee English</h3>
                    <p class="card-text mt-3">Boost your company's global capacity, professional writing, and workplace confidence with specialized corporate English training.</p>
                </div>
                <a asp-controller="Pages" asp-action="Services" class="btn btn-dark text-warning fw-bold mt-4">Corporate Programs</a>
            </div>
        </div>
    </div>

    <!-- Government & Public Sector Card (Coral/Red) -->
    <div class="col-md-4 mb-4">
        <div class="card h-100 bg-danger border-0 shadow">
            <div class="card-body text-center d-flex flex-column justify-content-between p-4">
                <div>
                    <h3 class="card-title fw-bold">Government Programmes</h3>
                    <p class="card-text mt-3">Structured, accredited language pathways designed for public sector advancement, international delegations, and official compliance.</p>
                </div>
                <a asp-controller="Pages" asp-action="ContactUs" class="btn btn-light text-danger fw-bold mt-4">Enquire for Institutions</a>
            </div>
        </div>
    </div>

</div>