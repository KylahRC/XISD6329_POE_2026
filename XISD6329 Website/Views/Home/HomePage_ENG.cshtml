@{
    ViewData["Title"] = "Study Better - Home";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <style>
        .container, .container-fluid {
            max-width: 100% !important;
            margin: 0 !important;
            padding: 0 !important;
        }

        /* section, div {
            text-align: left;
        } */

        body {
            margin: 0;
            font-family: Inter, sans-serif;
            background: #02091C;
            color: white;
        }



        

        /* Hero section */
        .hero {
            padding: 40px 20px;
            align-content: center;
            text-align: center
        }

            .hero h1 {
                font-family: "ADLaM Display", cursive;
                font-size: 64px;
                margin-bottom: 20px;
            }

            .hero p {
                font-size: 20px;
                max-width: 83%;
                margin: 0 auto;
            }

        /* Blocks row */
        .blocks {
            display: flex;
            justify-content: space-between;
            flex-wrap: wrap; /* allows stacking on small screens */
            width: 100%;
            padding: 40px 20px;
            gap: 20px;
        }

        .block {
            flex: 1 1 30%; /* about 320px of 1440px */
            min-width: 280px; /* ensures stacking when too narrow */
            height: 503px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: flex-start;
            color: black;
            font-size: 20px;
            background: #D9D9D9;
            box-shadow: 0 10px 4px rgba(0,0,0,0.25);
        }

            .block img {
                width: 85%;
                height: auto;
                margin-top: 20px;
                background: #D9D9D9;
            }

            .block h2 {
                margin-top: 20px;
                font-size: 36px;
            }

            .block button {
                margin-top: auto;
                margin-bottom: 20px;
                width: 70%;
                height: 52px;
                font-size: 20px;
                background: #D9D9D9;
                border: none;
                cursor: pointer;
                box-shadow: 0 10px 4px rgba(0,0,0,0.25);
            }

        /* Footer */
        footer {
            background: #01B697;
            width: 100%;
            height: 70px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 36px;
            color: white;
        }


    </style>
</head>
<body>

    

    

    <!-- Hero -->
    <section class="hero">
        <h1>Welcome</h1>
        <p>
            Introductory paragraph about the agency and what you offer so the client understands somewhat of what the purpose of the agency is and therefore can make an informed choice about which demographic their needs fall into.
        </p>
    </section>

    <!-- Blocks -->
    <div class="blocks">
        <div class="block" style="background:#2B74DD">
            <img src="https://placehold.co/272x166" alt="Private photo">
            <h2>Targeting private demographic</h2>
            <p>Photo relevant to the everyman</p>
            <button>Button link</button>
        </div>
        <div class="block" style="background:#E3AF20">
            <img src="https://placehold.co/272x166" alt="Corporate photo">
            <h2>Targeting Companies</h2>
            <p>Appeal to corporate with professional image</p>
            <button>To go to the</button>
        </div>
        <div class="block" style="background:#E86666">
            <img src="https://placehold.co/272x166" alt="Government photo">
            <h2>Target Government</h2>
            <p>Government related image</p>
            <button>Desired page</button>
        </div>
    </div>

    <!-- Footer -->
    <footer>
        Footer with relevant info
    </footer>

</body>
</html>
