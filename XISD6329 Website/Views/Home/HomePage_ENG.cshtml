@{
    ViewData["Title"] = "Study Better Agency - Home";
}

<style>
    body {
        background-color: #060d1f !important;
        color: #ffffff !important;
    }

    .playful-hero-title {
        font-family: 'Comic Sans MS', 'Bubblegum Sans', 'Segoe UI', cursive, sans-serif;
        letter-spacing: 0.5px;
        color: #ffffff !important;
    }

    .clean-section-title {
        color: #ffffff !important;
        letter-spacing: 1px;
    }

    .bright-white-text {
        color: #ffffff !important;
        font-size: 1.1rem;
        line-height: 1.7;
    }
</style>

<div class="container my-4 text-white">

    <!-- 1. Hero Section (Playful Title Only + Bright White Text) -->
    <div class="row align-items-center py-5 mb-5 rounded-4 shadow-lg" style="background-color: #0f172a; border: 1px solid rgba(255, 255, 255, 0.1);">
        <div class="col-lg-7 px-5">
            <!-- Chenged font to trebuchet, i think we use that for the headngs -->
            <h1 class="display-4 fw-bold playful-hero-title mb-4" style="font-family: 'Trebuchet MS'"> UNLOCK YOUR FUTURE WITH ENGLISH </h1>
            <p class="lead bright-white-text mb-4">
                English is no longer just a language. It’s a requirement for better jobs, career promotions, international opportunities and university admission. Whether you want to advance in your career or study abroad, we help you succeed every step of the way.
            </p>
            <div class="mt-4">
                <a asp-controller="Pages" asp-action="Register" class="btn text-white fw-bold rounded-circle d-inline-flex align-items-center justify-content-center shadow-lg" style="width: 140px; height: 140px; background-color: #2563eb; font-size: 1.1rem; text-decoration: none; transition: transform 0.2s;">
                    BOOK NOW
                </a>
            </div>
        </div>
        <!-- Make image bigger?? it looks oddly small, maybe crop the image if padding is the issue? -->
        <div class="col-lg-5 text-center mt-4 mt-lg-0">
            <img src="~/images/sba-logo.png" alt="Study Better Agency" class="img-fluid p-3" style="max-height: 280px;" />
        </div>
    </div>



    <!-- 2. Suitable For / Demographic Target Blocks -->
    <div class="my-5">
        <h2 class="text-center fw-bold mb-4 clean-section-title">SUITABLE FOR</h2>
        
        <div class="row g-4">
            <!-- Private -->
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow p-4 rounded-4 text-center" style="background-color: #2B74DD; color: #ffffff;">
                    <div class="mx-auto mb-3 rounded-circle overflow-hidden shadow-sm bg-white d-flex align-items-center justify-content-center" style="width: 150px; height: 150px;">
                        <img src="https://cdn.pixabay.com/photo/2024/06/03/09/27/ai-generated-8805927_1280.jpg" alt="Private photo" class="img-fluid" />
                    </div>
                    <h3 class="h4 fw-bold mb-3 text-white">Private Demographic</h3>
                    <p class="small mb-4 text-white">Improve daily communication, meet international friends, and experience vibrant student life in Cape Town with homestay options.</p>
                    <div class="mt-auto">
                        <a asp-controller="Pages" asp-action="Services" class="btn btn-light text-primary fw-bold px-4 py-2 rounded-pill shadow-sm">Explore Services</a>
                    </div>
                </div>
            </div>

            <!-- Corporate -->
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow p-4 rounded-4 text-center" style="background-color: #E3AF20; color: #ffffff;">
                    <!-- experimented with circle size, also the image doesnt fit?? need to zoom it i guess?? -->
                    <div class="mx-auto mb-3 rounded-circle overflow-hidden shadow-sm bg-white d-flex align-items-center justify-content-center" style="width: 350px; height: 350px;">
                        <img src="https://cdn.pixabay.com/photo/2020/07/08/04/12/work-5382501_1280.jpg" alt="Corporate photo" class="img-fluid" />
                    </div>
                    <h3 class="h4 fw-bold mb-3 text-white">Companies</h3>
                    <p class="small mb-4 text-white">Boost your company's global capacity, professional writing, and workplace confidence with specialized corporate training.</p>
                    <div class="mt-auto">
                        <a asp-controller="Pages" asp-action="Services" class="btn btn-dark text-white fw-bold px-4 py-2 rounded-pill shadow-sm">Corporate Services</a>
                    </div>
                </div>
            </div>

            <!-- Government -->
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow p-4 rounded-4 text-center" style="background-color: #E86666; color: #ffffff;">
                    <div class="mx-auto mb-3 rounded-circle overflow-hidden shadow-sm bg-white d-flex align-items-center justify-content-center" style="width: 150px; height: 150px;">
                        <img src="https://cdn.pixabay.com/photo/2025/07/03/10/52/worker-9694106_1280.jpg" alt="Government photo" class="img-fluid" />
                    </div>
                    <h3 class="h4 fw-bold mb-3 text-white">Governments</h3>
                    <p class="small mb-4 text-white">Structured, accredited language pathways designed for public sector advancement, international delegations, and official compliance.</p>
                    <div class="mt-auto">
                        <a asp-controller="Pages" asp-action="Services" class="btn btn-light text-danger fw-bold px-4 py-2 rounded-pill shadow-sm">Institutional Services</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 3. Additional Content Sections (All White Text on Dark Navy) -->
    <!-- Look into maybe making image recangle and fading them behind text? here is like an example i found https://jsfiddle.net/yw9v7zm5/ -->
    <div class="my-5 py-4 border-top border-secondary">
        <div class="row g-5 align-items-center mb-5">
            <div class="col-md-6 text-center">
                <div class="mx-auto rounded-circle overflow-hidden shadow-sm d-flex align-items-center justify-content-center bg-white" style="width: 250px; height: 250px;">
                    <img src="https://img1.wsimg.com/isteam/getty/2174878340/:/cr=t:0%25,l:33.33%25,w:66.67%25,h:100%25/rs=w:730,h:730,cg:true" alt="Courses" class="img-fluid" />
                </div>
            </div>
            <div class="col-md-6">
                <h3 class="fw-bold clean-section-title">English Courses</h3>
                <p class="bright-white-text mt-2">
                    Whether you're learning English for work, university, travel, or immigration, Study Better Agency offers high-quality English programmes designed to help you achieve your goals. We partner with carefully selected language schools in Cape Town that are known for excellent teaching, student support, and outstanding results.
                </p>
                <div class="mt-3">
                    <a asp-controller="Pages" asp-action="OnlineEnglishClasses" class="btn btn-primary px-4 fw-bold rounded-pill">Courses</a>
                </div>
            </div>
        </div>

        <div class="row g-5 align-items-center mb-5">
            <div class="col-md-6 order-md-2 text-center">
                <div class="mx-auto rounded-circle overflow-hidden shadow-sm d-flex align-items-center justify-content-center bg-white" style="width: 250px; height: 250px;">
                    <img src="https://img1.wsimg.com/isteam/getty/2245003412/:/cr=t:0%25,l:29.95%25,w:56.25%25,h:100%25/rs=w:730,h:730,cg:true" alt="Registration" class="img-fluid" />
                </div>
            </div>
            <div class="col-md-6 order-md-1">
                <h3 class="fw-bold clean-section-title">Registration Process</h3>
                <p class="bright-white-text mt-2">
                    Registration is quick and easy. Complete the online form and we will send you a quotation. Once you accepted the quotation, payment gets made. We then send you the invitation letters needed confirming your registration. Some countries get 30 or 90 days visa on arrival. If you need help applying, contact us.
                </p>
                <div class="mt-3">
                    <a asp-controller="Pages" asp-action="Register" class="btn btn-primary px-4 fw-bold rounded-pill">Register Here</a>
                </div>
            </div>
        </div>

        <div class="row g-5 align-items-center mb-5">
            <div class="col-md-6 text-center">
                <div class="mx-auto rounded-circle overflow-hidden shadow-sm d-flex align-items-center justify-content-center bg-white" style="width: 250px; height: 250px;">
                    <img src="https://img1.wsimg.com/isteam/getty/2228153270/:/cr=t:0%25,l:5.64%25,w:66.68%25,h:100%25/rs=w:730,h:730,cg:true" alt="Flight" class="img-fluid" />
                </div>
            </div>
            <div class="col-md-6">
                <h3 class="fw-bold clean-section-title">Book Your Flight</h3>
                <p class="bright-white-text mt-2">
                    Book your flight with Study Better Agency and Satguru Travel. Click below to qualify for competitive rates. One way help our clients save. We make your journey simple by assisting with flights and helping you arrange the medical cover required for your studies.
                </p>
                <div class="mt-3">
                    <a asp-controller="Pages" asp-action="FlightsAndMedical" class="btn btn-primary px-4 fw-bold rounded-pill">Book Flight</a>
                </div>
            </div>
        </div>

        <div class="row g-5 align-items-center mb-5">
            <div class="col-md-6 order-md-2 text-center">
                <div class="mx-auto rounded-circle overflow-hidden shadow-sm d-flex align-items-center justify-content-center bg-white" style="width: 250px; height: 250px;">
                    <img src="https://img1.wsimg.com/isteam/getty/817577652/:/rs=w:730,h:730,cg:true,m/cr=w:730,h:730" alt="TEFL" class="img-fluid" />
                </div>
            </div>
            <div class="col-md-6 order-md-1">
                <h3 class="fw-bold clean-section-title">Become an English Teacher</h3>
                <p class="bright-white-text mt-2">
                    We now offer an internationally recognized TEFL (Teaching English as a Foreign Language) course. Gain certification and open doors to teaching English overseas or online.
                </p>
                <div class="mt-3">
                    <a asp-controller="Pages" asp-action="TEFLInstitute" class="btn btn-primary px-4 fw-bold rounded-pill">Find Out More</a>
                </div>
            </div>
        </div>
    </div>

</div>